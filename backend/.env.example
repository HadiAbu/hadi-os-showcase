# Copy to .env and fill in. Only the first four are required to run the app.

# --- Required ---
TURSO_DATABASE_URL=https://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token
JWT_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- LLM (OpenAI-compatible; optional — absent => AI endpoints return 503) ---
# Enables chat, onboarding AI extraction, and dashboard "focus now".
# Default provider is Groq (free tier): get a gsk_... key at https://console.groq.com
# (check console.groq.com/docs/models for a current model id if this one is retired)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
#
# To use OpenAI instead:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
# To use a local Ollama:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=llama3.1
#   LLM_API_KEY=ollama   (any non-empty string)

# --- Optional ---
# Fernet key for encrypting third-party tokens at rest (Phase 3; unused now)
TOKEN_ENCRYPTION_KEY=
# dev (default) or prod — prod adds the HSTS header
ENVIRONMENT=dev
